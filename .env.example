# Set to the final canonical origin on Vercel, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://pamirecotourism.com

# Staff login for /admin. Set both on Vercel before using the admin.
ADMIN_EMAIL=admin@pamirecotourism.com
ADMIN_PASSWORD=
AUTH_SECRET=

# Telegram bot for new inquiries. Only private chats that send this password get them.
# After deploying, open /admin/telegram and press "Подключить бота".
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_PASSWORD=

# Private Vercel Blob store. Photos, the tour catalog, and inquiries are saved here.
BLOB_READ_WRITE_TOKEN=
